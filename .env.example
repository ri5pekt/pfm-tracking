# Database / Redis
DATABASE_URL=postgres://pfm:pfm@localhost:5432/pfm_tracking
REDIS_URL=redis://localhost:6379

# API
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
# Production: PUBLIC_BASE_URL=https://tracking.particleformen.com
ADMIN_SESSION_SECRET=change-me-to-a-long-random-string
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=change-me-bootstrap

# Build / version (set by CI; optional locally)
APP_VERSION=0.1.0
GIT_SHA=dev

# Postgres password used by docker-compose.prod.yml
# POSTGRES_PASSWORD=

# ShipBob (Phase 1)
# SHIPBOB_API_KEY=
# SHIPBOB_CHANNEL_ID=180705
# SHIPBOB_API_BASE=https://api.shipbob.com/1.0
# SHIPBOB_TRACKING_API_BASE=https://api.shipbob.com/2026-07
# Fresh-start lookback when no sync cursor (hours). Local default 48; prod: 1
SHIPBOB_ORDERS_LOOKBACK_HOURS=48

# KLB / TrackingMore (Phase 2)
# KLB_API_KEY=
# KLB_API_SECRET=
# KLB_LEGACY_API_SECRET=
# KLB_API_BASE=https://app.zenventory.com/rest
# TRACKINGMORE_API_KEY=
# TRACKINGMORE_API_BASE=https://api.trackingmore.com/v4
# Fresh-start: 0 = today UTC only; local default 30
KLB_WINDOW_DAYS=30

# Klaviyo (Phase 3) — Events API: https://a.klaviyo.com/api/events/
# Private key from Particle theme (ParticleKlaviyoHelper). Never commit the real key.
# KLAVIYO_API_KEY=pk_...
# KLAVIYO_API_BASE=https://a.klaviyo.com
KLAVIYO_DRY_RUN=true
# Metrics: PFM Tracking - Shipped | In Transit | Out For Delivery | Received Delivery |
# Failed Delivery Attempt | Delivery Exception | Stalled
STALLED_DAYS=7

# RichPanel read-only API
# RICHPANEL_API_KEY=

# Product catalog (optional override; default: particle-shopify products.json path on this machine)
# PRODUCTS_JSON_PATH=
